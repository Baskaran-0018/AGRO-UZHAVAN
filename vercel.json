{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|icons/|favicon.svg|manifest.webmanifest|manifest.json|sw.js|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
