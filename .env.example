# GEMINI_API_KEY: Required for Gemini AI API calls (crop diagnostics, AI advisory, audio speech).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OpenWeatherMap API Key (Optional: defaults to accurate Open-Meteo live data automatically if omitted)
OPENWEATHER_API_KEY="YOUR_OPENWEATHER_API_KEY"
VITE_OPENWEATHER_API_KEY="YOUR_OPENWEATHER_API_KEY"

# APP_URL: Local or production hosting URL
APP_URL="http://localhost:3000"
